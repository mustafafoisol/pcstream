<?xml version="1.0" encoding="utf-8"?>
<!-- The PC server is plain HTTP on the local network, so cleartext must be
     allowed. Android 10 blocks it by default. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
